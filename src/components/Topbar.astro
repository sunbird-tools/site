---
const links = [
   {
      label: 'Plugin API',
      href: 'https://github.com/sunbird-tools/sunbird/blob/main/crates/runtime/phoenix.d.ts',
      path: 'M4 4.5A1.5 1.5 0 0 1 5.5 3H11v14H5.5A1.5 1.5 0 0 0 4 18.5zm0 14A1.5 1.5 0 0 0 5.5 20H20V3h-9M8 7h3M15 7h2M15 11h2',
   },
   {
      label: 'Issues',
      href: 'https://github.com/sunbird-tools/sunbird/issues',
      path: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zm0-13v5m0 3.5v.01',
   },
];
---

<nav class="top">
   <a class="wordmark" href="/" title="sunbird"
      ><span class="dot" aria-hidden="true"></span><span class="sr">sunbird</span></a
   >
   <div class="icons">
      {links.map(({ label, href, path }) => (
            <a class="icon" href={href} title={label}>
               <span class="sr">{label}</span>
               <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d={path} />
               </svg>
            </a>
         ))}
      <a
         class="icon"
         href="https://github.com/sunbird-tools/sunbird"
         aria-label="GitHub"
         title="GitHub"
      >
         <svg viewBox="0 0 24 24" aria-hidden="true" class="filled">
            <path
               d="M12 2C6.5 2 2 6.6 2 12.2c0 4.5 2.9 8.3 6.8 9.7.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.4-3.4-1.4-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 2.9.9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10.1 10.1 0 0 0 22 12.2C22 6.6 17.5 2 12 2z"
            />
         </svg>
      </a>
      <button type="button" class="icon" id="theme" aria-label="Toggle theme" title="Toggle theme">
         <svg viewBox="0 0 24 24" aria-hidden="true" class="sun">
            <path
               d="M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            />
         </svg>
         <svg viewBox="0 0 24 24" aria-hidden="true" class="moon">
            <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z" />
         </svg>
      </button>
   </div>
</nav>

<style>
.top {
   display: flex;
   align-items: center;
   justify-content: space-between;
}

.wordmark {
   display: flex;
   align-items: center;
   gap: 10px;
   font-size: 16px;
   font-weight: 800;
   letter-spacing: -0.03em;
   text-decoration: none;
}

.dot {
   width: 14px;
   height: 14px;
   background: var(--accent);
   transform: rotate(45deg);
}

.icons {
   display: flex;
   gap: 4px;
}

.icon {
   display: grid;
   place-items: center;
   width: 34px;
   height: 34px;
   padding: 0;
   color: var(--muted);
   background: none;
   border: 1px solid transparent;
   border-radius: var(--radius);
   transition:
      color 0.12s,
      border-color 0.12s;

   &:hover:not(:disabled) {
      color: var(--text);
      background: none;
      border-color: var(--border);
   }

   & svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.7;
      stroke-linecap: round;
      stroke-linejoin: round;
   }

   & svg.filled {
      fill: currentColor;
      stroke: none;
   }
}

.moon {
   display: none;
}

@media (prefers-color-scheme: light) {
   :global(:root:not([data-theme="dark"])) .sun {
      display: none;
   }

   :global(:root:not([data-theme="dark"])) .moon {
      display: block;
   }
}

:global(:root[data-theme="light"]) .sun {
   display: none;
}

:global(:root[data-theme="light"]) .moon {
   display: block;
}
</style>

<script>
import { byId } from '../lib/dom';

const root = document.documentElement;
const system = matchMedia('(prefers-color-scheme: dark)');

byId('theme', HTMLButtonElement).onclick = () => {
   const dark = (root.dataset.theme ?? (system.matches ? 'dark' : 'light')) === 'dark';
   root.dataset.theme = dark ? 'light' : 'dark';
   localStorage.setItem('theme', root.dataset.theme);
};
</script>

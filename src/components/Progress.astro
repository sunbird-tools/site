<section class="box panel" id="progress" hidden>
   <ol id="steps"></ol>
   <pre id="log"></pre>
   <template id="step">
      <li>
         <span class="label"></span>
         <span class="state">waiting</span>
         <span class="bar"><i></i></span>
      </li>
   </template>
</section>

<style>
.panel {
   margin-top: 14px;
   padding: 14px 16px;
}

ol {
   margin: 0;
   padding: 0;
   font-size: 13.5px;
   list-style: none;
}

li {
   display: grid;
   grid-template-columns: 1fr auto;
   gap: 5px 12px;
   padding: 7px 0;

   & + & {
      border-top: 1px solid var(--border);
   }
}

.label {
   font-weight: 500;
}

.bar {
   grid-column: 1 / -1;
   height: 3px;
   overflow: hidden;
   background: var(--border);
   border-radius: 2px;

   & i {
      display: block;
      width: 0;
      height: 100%;
      background: var(--text);
      transition: width 0.16s ease-out;
   }

   .done & i {
      background: var(--ok);
   }

   .fail & i {
      background: var(--err);
   }
}

.state {
   color: var(--muted);
   font-variant-numeric: tabular-nums;

   .done & {
      color: var(--ok);
   }

   .fail & {
      color: var(--err);
   }
}

pre {
   max-height: 200px;
   margin: 12px 0 0;
   padding: 10px 12px;
   overflow: auto;
   font: var(--mono);
   white-space: pre-wrap;
   color: var(--muted);
   background: var(--bg);
   border: 1px solid var(--border);
   border-radius: var(--radius);

   &:empty {
      display: none;
   }
}
</style>

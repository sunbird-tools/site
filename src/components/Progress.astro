<section class="card" id="progress" hidden>
   <ol id="steps"></ol>
   <pre id="log"></pre>
   <template id="step">
      <li>
         <span class="label"></span>
         <span class="state">waiting</span>
         <span class="bar"><i></i></span>
      </li>
   </template>
</section>

<style>
ol {
   margin: 0;
   padding: 0;
   font-size: 14px;
   list-style: none;
}

li {
   display: grid;
   grid-template-columns: 1fr auto;
   gap: 2px 8px;
   padding: 6px 0;
}

.bar {
   grid-column: 1 / -1;
   height: 4px;
   overflow: hidden;
   background: var(--line);
   border-radius: 2px;

   & i {
      display: block;
      width: 0;
      height: 100%;
      background: var(--accent);
      transition: width 0.2s;
   }
}

.state {
   color: var(--muted);
   font-variant-numeric: tabular-nums;

   .done & {
      color: var(--ok);
   }

   .fail & {
      color: var(--err);
   }
}

pre {
   max-height: 180px;
   margin: 10px 0 0;
   overflow: auto;
   font: var(--mono);
   white-space: pre-wrap;
   color: var(--muted);
}
</style>

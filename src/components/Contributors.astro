---
import { getCollection } from 'astro:content';

const contributors = (await getCollection('contributors'))
   .map(({ data }) => data)
   .sort((left, right) => right.contributions - left.contributions);
---

<section class="group">
   <div class="group-head">
      <h2>Contributors</h2>
   </div>
   <div class="contributors">
      {contributors.map(({ name, url, avatar }) => (
            <a class="contributor" href={url}>
               <img src={`${avatar}&s=48`} alt="" width="22" height="22" loading="lazy" />
               <span>{name}</span>
            </a>
         ))}
   </div>
</section>

<style>
.contributors {
   display: flex;
   flex-wrap: wrap;
   gap: 8px 20px;
}

.contributor {
   display: inline-flex;
   align-items: center;
   gap: 8px;
   padding: 4px 0;
   font-size: 13.5px;
   color: var(--text);
   text-decoration: none;

   &:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
   }
}

img {
   display: block;
   border-radius: 50%;
   background: var(--border);
}
</style>

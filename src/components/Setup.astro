---
import { DENSITIES, LANGUAGES, VERIFIED } from '../lib/discord';

const languageNames = new Intl.DisplayNames(['en'], { type: 'language' });
const languageOptions = LANGUAGES.map((code) => ({
   code,
   label: `${languageNames.of(code) ?? code} (${code})`,
}));
---

<section class="group">
   <div class="group-head">
      <h2>Build</h2>
   </div>
   <div class="box setup">
      <div class="form-grid">
         <div class="field">
            <label for="ver">Version</label>
            <select id="ver">
               {VERIFIED.map((code) => <option value={code}>{code} (verified)</option>)}
            </select>
         </div>
         <div class="field">
            <label for="mode">Install mode</label>
            <select id="mode">
               <option value="replace" selected>Replace Discord</option>
               <option value="side">Alongside Discord</option>
            </select>
         </div>
         <div class="field">
            <label for="dpi">Screen density</label>
            <select id="dpi">
               {DENSITIES.map(({ name, dpi }) => (
                  <option value={name}>
                     {name} ({dpi} dpi)
                  </option>
               ))}
            </select>
         </div>
         <div class="field">
            <label for="lang">Language</label>
            <select id="lang">
               <option value="none">None</option>
               {languageOptions.map(({ code, label }) => (
                  <option value={code} selected={code === 'en'}>
                     {label}
                  </option>
               ))}
            </select>
         </div>
      </div>
      <div class="field pkg-field" id="pkg-row" hidden>
         <label for="pkg">Package name</label>
         <input
            type="text"
            id="pkg"
            value="com.discord.phoenix"
            spellcheck="false"
            autocapitalize="off"
            autocomplete="off"
         >
      </div>
   </div>
</section>

<style>
.setup {
   padding: 16px;
}

.form-grid {
   display: grid;
   grid-template-columns: repeat(2, minmax(0, 1fr));
   gap: 12px 16px;
}

.field {
   display: flex;
   flex-direction: column;
   gap: 5px;
   min-width: 0;
}

.pkg-field {
   margin-top: 12px;
   padding-top: 12px;
   border-top: 1px solid var(--border);

   & input {
      font: var(--mono);
      font-size: 13.5px;
   }
}

label {
   font-size: 12.5px;
   font-weight: 500;
   color: var(--muted);
}

@media (max-width: 560px) {
   .form-grid {
      grid-template-columns: 1fr;
   }
}
</style>

<script>
import { DENSITIES, LANGUAGES, TRACKER, VERIFIED } from '../lib/discord';
import { byId } from '../lib/dom';
import { checkPackage } from '../lib/inputs';

const screen = Math.round((window.devicePixelRatio || 1) * 160);
const density = DENSITIES.find(({ dpi }) => dpi >= screen) ?? DENSITIES.at(-1);
if (density) byId('dpi', HTMLSelectElement).value = density.name;

const language = (navigator.language || 'en').slice(0, 2).toLowerCase();
if (LANGUAGES.some((known) => known === language)) byId('lang', HTMLSelectElement).value = language;

const mode = byId('mode', HTMLSelectElement);
mode.onchange = () => {
   byId('pkg-row', HTMLDivElement).hidden = mode.value === 'replace';
   checkPackage();
};
byId('pkg', HTMLInputElement).oninput = checkPackage;

interface TrackerIndex {
   latest?: { alpha?: number };
}

fetch(`${TRACKER}/tracker/index`)
   .then((response) => response.json() as Promise<TrackerIndex>)
   .then(({ latest }) => {
      const alpha = latest?.alpha;
      if (!alpha || VERIFIED.includes(alpha)) return;
      const versions = byId('ver', HTMLSelectElement);
      const older = [...versions.options].find((option) => Number(option.value) < alpha) ?? null;
      versions.add(new Option(`${alpha} (alpha, untested)`, String(alpha)), older);
   })
   .catch(() => {});
</script>

---
import { ICONS, PLATFORM_GROUPS, STATUS, type Status, isSupported } from '../lib/platforms';
---

<section class="group" aria-label="Platform support">
   <div class="group-head">
      <h2>Platform support</h2>
   </div>
   <div class="platforms">
      {PLATFORM_GROUPS.map((group) => (
            <div>
               <h3 class="kicker">{group.name}</h3>
               <div class="cards" style={`--count: ${group.systems.length}`}>
                  {group.systems.map((system) => (
                        <button
                           type="button"
                           class:list={['card', { runs: isSupported(system) }]}
                           data-select-tab={system.id}
                        >
                           <span class="os">
                              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                                 <path d={ICONS[system.icon]} />
                              </svg>
                              {system.name}
                           </span>
                           <ul class="segments">
                              {system.arches.map(([arch, status]) => (
                                    <li class={status} title={STATUS[status]}>
                                       <span class="track" />
                                       <span class="label">{arch}</span>
                                       <span class="sr">{STATUS[status]}</span>
                                    </li>
                                 ))}
                           </ul>
                        </button>
                     ))}
               </div>
            </div>
         ))}

      <ul class="legend" aria-label="Legend">
         {(Object.keys(STATUS) as Status[]).map((status) => (
               <li class={status}>
                  <span class="track" />
                  {STATUS[status]}
               </li>
            ))}
      </ul>
   </div>
</section>

<style>
.platforms {
   display: grid;
   gap: 16px;
}

.kicker {
   margin: 0 0 8px;
   font-size: 12px;
   font-weight: 500;
   letter-spacing: 0;
   color: var(--muted);
}

.cards {
   display: grid;
   grid-template-columns: repeat(var(--count), 1fr);
   gap: 6px;

   @media (max-width: 560px) {
      grid-template-columns: 1fr;
   }
}

.card {
   display: grid;
   align-content: start;
   justify-items: stretch;
   gap: 12px;
   padding: 12px;
   text-align: left;
   font-weight: 400;
   color: inherit;
   background: var(--surface);
   border: 1px solid var(--border);
   border-radius: var(--radius);
   cursor: pointer;
   transition:
      border-color 0.12s,
      background-color 0.12s;

   &.runs {
      border-color: var(--border-strong);
   }

   &:hover:not(:disabled) {
      background: var(--hover);
      border-color: var(--accent);
   }
}

.os {
   display: inline-flex;
   align-items: center;
   gap: 8px;
   font-size: 14px;
   font-weight: 650;
   letter-spacing: -0.01em;
   color: var(--muted);

   .runs & {
      color: var(--text);
   }
}

.icon {
   width: 15px;
   height: 15px;
   flex: none;
   fill: currentColor;

   .runs & {
      color: var(--ok);
   }
}

.segments {
   display: flex;
   gap: 3px;
   margin: 0;
   padding: 0;
   list-style: none;

   & li {
      display: grid;
      flex: 1;
      gap: 6px;
      min-width: 0;
   }
}

.track {
   height: 4px;
   border-radius: 1px;
   background: var(--border);

   .ready & {
      background: var(--ok);
   }

   .wip & {
      background: repeating-linear-gradient(
         -45deg,
         var(--warn) 0 3px,
         color-mix(in oklab, var(--warn) 35%, transparent) 3px 6px
      );
   }
}

.label {
   overflow: hidden;
   font: 500 11px / 1.3 var(--mono-family);
   color: var(--muted);
   text-overflow: ellipsis;
   white-space: nowrap;

   .ready &,
   .wip & {
      color: var(--text);
   }
}

.legend {
   display: flex;
   flex-wrap: wrap;
   gap: 18px;
   margin: 0;
   padding: 0;
   list-style: none;
   font-size: 12px;
   color: var(--muted);

   & li {
      display: inline-flex;
      align-items: center;
      gap: 8px;
   }

   & .track {
      width: 16px;
   }
}
</style>

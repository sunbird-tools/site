---
import Contributors from '../components/Contributors.astro';
import Manual from '../components/Manual.astro';
import Plugins from '../components/Plugins.astro';
import Progress from '../components/Progress.astro';
import Result from '../components/Result.astro';
import Setup from '../components/Setup.astro';
import Topbar from '../components/Topbar.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Sunbird" description="Patch Discord's native Android client in your browser.">
   <Topbar />

   <header class="head">
      <h1>Sunbird</h1>
      <p class="lede">Unlock Discord's native Android client <em>and</em> bundle plugins!</p>
      <ul class="arch" aria-label="Architecture support">
         <li class="ready" title="Supported">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
               <circle cx="6" cy="6" r="5" stroke="currentColor" stroke-width="1.3" />
               <path
                  d="M3.75 6.15 5.3 7.7 8.4 4.5"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
               />
            </svg>
            <span>arm64</span>
         </li>
         <li class="ready" title="Supported">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
               <circle cx="6" cy="6" r="5" stroke="currentColor" stroke-width="1.3" />
               <path
                  d="M3.75 6.15 5.3 7.7 8.4 4.5"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
               />
            </svg>
            <span>armv7</span>
         </li>
         <li class="wip" title="In progress">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
               <circle cx="6" cy="6" r="5" stroke="currentColor" stroke-width="1.3" opacity="0.3" />
               <path
                  d="M6 1a5 5 0 1 1-5 5"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"
               />
            </svg>
            <span>x86_64</span>
         </li>
         {(['x86'] as const).map((abi) => (
            <li class="planned" title="Planned">
               <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <circle
                     cx="6"
                     cy="6"
                     r="5"
                     stroke="currentColor"
                     stroke-width="1.3"
                     stroke-dasharray="2.4 2.4"
                  />
               </svg>
               <span>{abi}</span>
            </li>
         ))}
      </ul>
   </header>

   <Setup />
   <Plugins />

   <div class="actions">
      <div class="actions-inner">
         <p class="summary" id="summary"></p>
         <button type="button" id="go">Patch Discord</button>
      </div>
      <p class="err" id="err" hidden></p>
   </div>

   <Progress />
   <Manual />
   <Result />
   <Contributors />

   <footer class="foot">
      <span>Not affiliated with Discord.</span>
      <a href="https://github.com/sunbird-tools/sunbird">sunbird-tools/sunbird</a>
   </footer>
</Base>

<style>
.head {
   padding: 56px 0 8px;
}

.lede {
   max-width: 52ch;
   margin-top: 20px;
   font-size: 15.5px;
   color: var(--muted);
}

.arch {
   display: flex;
   flex-wrap: wrap;
   gap: 8px;
   margin: 20px 0 0;
   padding: 0;
   list-style: none;
   font: 500 12px / 1 var(--mono-family);

   & li {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 9px;
      border-radius: var(--radius);
   }

   & .ready {
      color: var(--text);
      background: var(--surface);
      border: 1px solid var(--border-strong);

      & svg {
         color: var(--ok);
      }
   }

   & .wip {
      color: var(--text);
      background: var(--surface);
      border: 1px solid var(--border);

      & svg {
         color: var(--warn);
      }
   }

   & .planned {
      color: var(--muted);
      border: 1px dashed var(--border);

      & svg {
         color: var(--muted);
         opacity: 0.7;
      }
   }
}

.actions {
   position: sticky;
   bottom: 0;
   z-index: 1;
   margin: 40px -12px 0;
   padding: 12px;
   background: linear-gradient(to bottom, transparent, var(--bg) 40%);
}

.actions-inner {
   display: flex;
   align-items: center;
   gap: 14px;
   padding: 8px 8px 8px 16px;
   background: var(--surface);
   border: 1px solid var(--border-strong);
   border-radius: var(--radius);
}

.summary {
   flex: 1;
   min-width: 0;
   font: 12.5px / 1.4 var(--mono-family);
   color: var(--muted);
   overflow: hidden;
   text-overflow: ellipsis;
   white-space: nowrap;

   & :global(b) {
      font-weight: 600;
      color: var(--text);
   }

   & :global(.dot-sep) {
      margin-inline: 6px;
      color: var(--border-strong);
   }
}

#go {
   flex-shrink: 0;
   padding-inline: 22px;
}

@media (max-width: 560px) {
   .summary {
      font-size: 11.5px;
      white-space: normal;
   }
}

.foot {
   display: flex;
   flex-wrap: wrap;
   justify-content: space-between;
   gap: 6px 16px;
   margin-top: 40px;
   padding: 16px 0 40px;
   border-top: 1px solid var(--border);
   font-size: 13px;
   color: var(--muted);

   & a {
      color: var(--muted);

      &:hover {
         color: var(--text);
      }
   }
}
</style>

<script src="../scripts/patch.ts"></script>
<script>
import { PACKAGE } from '../lib/discord';
import { byId } from '../lib/dom';

const summary = byId('summary', HTMLParagraphElement);
const version = byId('ver', HTMLSelectElement);
const mode = byId('mode', HTMLSelectElement);
const pkg = byId('pkg', HTMLInputElement);
const runtime = byId('runtime', HTMLInputElement);
const fridaOn = byId('frida-on', HTMLInputElement);
const customFiles = byId('jsp-files', HTMLInputElement);
const customCode = byId('jsp-code', HTMLTextAreaElement);

const part = (text: string, strong = false) => {
   const el = document.createElement(strong ? 'b' : 'span');
   el.textContent = text;
   return el;
};

const sep = () => {
   const el = document.createElement('span');
   el.className = 'dot-sep';
   el.textContent = '·';
   return el;
};

const update = () => {
   const bundled = document.querySelectorAll('#jsp-bundled input:checked').length;
   const custom = (customFiles.files?.length ?? 0) + (customCode.value.trim() ? 1 : 0);
   const total = bundled + custom;
   const base = runtime.checked ? `${total} plugin${total === 1 ? '' : 's'}` : 'unlock only';
   const extras = fridaOn.checked ? `${base} + Frida` : base;
   const target = mode.value === 'replace' ? PACKAGE : pkg.value.trim() || 'com.discord.phoenix';

   summary.replaceChildren(
      part(`Build ${version.value}`, true),
      sep(),
      part(extras, true),
      sep(),
      part(target),
   );
};

document.addEventListener('change', update);
document.addEventListener('click', update);
document.addEventListener('input', update);
update();
</script>

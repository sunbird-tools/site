---
import Contributors from '../components/Contributors.astro';
import Desktop from '../components/Desktop.astro';
import Ios from '../components/Ios.astro';
import Manual from '../components/Manual.astro';
import PlatformTabs from '../components/PlatformTabs.astro';
import Platforms from '../components/Platforms.astro';
import Plugins from '../components/Plugins.astro';
import Progress from '../components/Progress.astro';
import Result from '../components/Result.astro';
import Setup from '../components/Setup.astro';
import Topbar from '../components/Topbar.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Sunbird" description="Patch Discord's native clients in your browser.">
   <Topbar />

   <header class="head">
      <h1>Sunbird</h1>
      <p class="lede">Unlock Discord's native client <em>and</em> bundle plugins!</p>
      <p class="warn alpha-warn" role="note">
         <b>Alpha builds.</b>{' '}These are unreleased Discord alpha builds and will contain bugs,
         crashes, and missing features. Don't blame Discord or report bugs from these builds to
         them.
      </p>
      <PlatformTabs />
   </header>

   <div class="tab-stage" id="tab-stage">
      <div class="tab-lead" data-tabs="android">
         <Setup />
      </div>

      <div class="tab-lead" data-tabs="ios">
         <Ios />
      </div>

      <div data-tabs="android ios">
         <Plugins />
      </div>

      <div class="actions" data-tabs="android">
         <div class="actions-inner">
            <p class="summary" id="summary"></p>
            <button type="button" id="go">Patch Discord</button>
         </div>
         <p class="err" id="err" hidden></p>
      </div>

      <div class="actions" data-tabs="ios">
         <div class="actions-inner">
            <p class="summary" id="ipa-summary"></p>
            <button type="button" id="ipa-go">Patch IPA</button>
         </div>
         <p class="warn" id="ipa-warn" hidden></p>
         <p class="err" id="ipa-err" hidden></p>
      </div>

      <div data-tabs="android ios">
         <Progress />
      </div>

      <div data-tabs="android">
         <Manual />
         <Result />
      </div>

      <div data-tabs="ios">
         <section class="box result" id="ipa-result" hidden>
            <!-- biome-ignore lint/a11y/useValidAnchor: ipa.ts sets href to the IPA's object URL -->
            <a class="button dl" id="ipa-dl" download>Download patched IPA</a>
            <ol class="steps-list">
               <li>
                  Sideload it with a tool that signs it for your device, like AltStore or
                  Sideloadly.
               </li>
               <li>Open Discord, switch it to the new native client, then relaunch it.</li>
            </ol>
         </section>
      </div>

      <div class="tab-lead" data-tabs="windows">
         <Desktop os="windows" />
      </div>

      <div class="tab-lead" data-tabs="linux">
         <Desktop os="linux" />
      </div>

      <div class="tab-lead" data-tabs="macos">
         <Desktop os="macos" />
      </div>
   </div>

   <Platforms />
   <Contributors />

   <footer class="foot">
      <span>Not affiliated with Discord.</span>
      <a href="https://github.com/sunbird-tools/sunbird">sunbird-tools/sunbird</a>
   </footer>
</Base>

<style>
.head {
   padding: 56px 0 0;
}

.lede {
   max-width: 52ch;
   margin-top: 20px;
   font-size: 15.5px;
   color: var(--muted);
}

.alpha-warn {
   margin-top: 20px;
}

:global(:root:not([data-platform])) [data-tabs]:not([data-tabs~="android"]),
:global(:root[data-platform="android"]) [data-tabs]:not([data-tabs~="android"]),
:global(:root[data-platform="ios"]) [data-tabs]:not([data-tabs~="ios"]),
:global(:root[data-platform="windows"]) [data-tabs]:not([data-tabs~="windows"]),
:global(:root[data-platform="linux"]) [data-tabs]:not([data-tabs~="linux"]),
:global(:root[data-platform="macos"]) [data-tabs]:not([data-tabs~="macos"]) {
   display: none;
}

.tab-lead :global(.group) {
   margin-top: 22px;
}

.actions {
   position: sticky;
   bottom: 0;
   z-index: 1;
   margin: 40px -12px 0;
   padding: 12px;
   background: linear-gradient(to bottom, transparent, var(--bg) 40%);
}

.actions-inner {
   display: flex;
   align-items: center;
   gap: 14px;
   padding: 8px 8px 8px 16px;
   background: var(--surface);
   border: 1px solid var(--border-strong);
   border-radius: var(--radius);
}

.summary {
   flex: 1;
   min-width: 0;
   font: 12.5px / 1.4 var(--mono-family);
   color: var(--muted);
   overflow: hidden;
   text-overflow: ellipsis;
   white-space: nowrap;

   & :global(b) {
      font-weight: 600;
      color: var(--text);
   }

   & :global(.dot-sep) {
      margin-inline: 6px;
      color: var(--border-strong);
   }
}

#go,
#ipa-go {
   flex-shrink: 0;
   padding-inline: 22px;
}

.result {
   margin-top: 14px;
   padding: 16px;
   border-color: var(--border-strong);
}

.dl {
   width: 100%;
}

.steps-list {
   margin: 14px 0 0;
   padding-left: 18px;
   font-size: 13.5px;
   color: var(--muted);

   & li {
      padding: 2px 0;
   }
}

@media (max-width: 560px) {
   .summary {
      font-size: 11.5px;
      white-space: normal;
   }
}

.foot {
   display: flex;
   flex-wrap: wrap;
   justify-content: space-between;
   gap: 6px 16px;
   margin-top: 40px;
   padding: 16px 0 40px;
   border-top: 1px solid var(--border);
   font-size: 13px;
   color: var(--muted);

   & a {
      color: var(--muted);

      &:hover {
         color: var(--text);
      }
   }
}
</style>

<script src="../scripts/patch.ts"></script>
<script>
import { IOS_IPA, PACKAGE } from '../lib/discord';
import { byId } from '../lib/dom';
import type { PlatformId } from '../lib/platforms';

const VALID_TABS: readonly PlatformId[] = ['android', 'ios', 'windows', 'linux', 'macos'];
const isTab = (value: string | undefined): value is PlatformId =>
   VALID_TABS.includes(value as PlatformId);

const root = document.documentElement;
const tabs = [...document.querySelectorAll<HTMLButtonElement>('#platform-tabs [data-tab]')];
const panels = [...document.querySelectorAll<HTMLElement>('[data-tabs]')];
const advancedPanel = byId('advanced-panel', HTMLDetailsElement);
const progress = byId('progress', HTMLElement);
const steps = byId('steps', HTMLOListElement);

function selectTab(next: PlatformId, updateHash = true) {
   root.dataset.platform = next;

   for (const tab of tabs) {
      const active = tab.dataset.tab === next;
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
   }

   for (const panel of panels) {
      const owners = panel.dataset.tabs?.split(' ') ?? [];
      panel.hidden = !owners.includes(next);
   }

   advancedPanel.hidden = next !== 'android';

   const hasSteps = steps.childElementCount > 0;
   progress.hidden = !(hasSteps && progress.dataset.owner === next);

   if (updateHash && location.hash !== `#${next}`) {
      history.replaceState(null, '', `#${next}`);
   }
}

for (const tab of tabs) {
   tab.onclick = () => {
      const target = tab.dataset.tab;
      if (isTab(target)) selectTab(target);
   };

   tab.onkeydown = (event) => {
      const current = tabs.indexOf(tab);
      let nextIndex = -1;
      if (event.key === 'ArrowRight') nextIndex = (current + 1) % tabs.length;
      else if (event.key === 'ArrowLeft') nextIndex = (current - 1 + tabs.length) % tabs.length;
      else if (event.key === 'Home') nextIndex = 0;
      else if (event.key === 'End') nextIndex = tabs.length - 1;
      if (nextIndex === -1) return;

      event.preventDefault();
      const targetTab = tabs[nextIndex];
      const target = targetTab?.dataset.tab;
      if (targetTab && isTab(target)) {
         selectTab(target);
         targetTab.focus();
      }
   };
}

for (const card of document.querySelectorAll<HTMLButtonElement>('[data-select-tab]')) {
   card.onclick = () => {
      const target = card.dataset.selectTab;
      if (!isTab(target)) return;
      selectTab(target);
      byId('platform-tabs', HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'start' });
   };
}

window.addEventListener('hashchange', () => {
   const hash = location.hash.slice(1).toLowerCase();
   if (isTab(hash)) selectTab(hash, false);
});

const initial = isTab(root.dataset.platform) ? root.dataset.platform : 'android';
selectTab(initial, false);

const summary = byId('summary', HTMLParagraphElement);
const ipaSummary = byId('ipa-summary', HTMLParagraphElement);
const ipaFile = byId('ipa-file', HTMLInputElement);
const version = byId('ver', HTMLSelectElement);
const mode = byId('mode', HTMLSelectElement);
const pkg = byId('pkg', HTMLInputElement);
const runtime = byId('runtime', HTMLInputElement);
const fridaOn = byId('frida-on', HTMLInputElement);
const customFiles = byId('jsp-files', HTMLInputElement);
const customCode = byId('jsp-code', HTMLTextAreaElement);

const part = (text: string, strong = false) => {
   const el = document.createElement(strong ? 'b' : 'span');
   el.textContent = text;
   return el;
};

const sep = () => {
   const el = document.createElement('span');
   el.className = 'dot-sep';
   el.textContent = '·';
   return el;
};

const update = () => {
   const bundled = document.querySelectorAll('#jsp-bundled input:checked').length;
   const custom = (customFiles.files?.length ?? 0) + (customCode.value.trim() ? 1 : 0);
   const total = bundled + custom;
   const pluginLabel = `${total} plugin${total === 1 ? '' : 's'}`;
   const base = runtime.checked ? pluginLabel : 'unlock only';
   const extras = fridaOn.checked ? `${base} + Frida` : base;
   const target = mode.value === 'replace' ? PACKAGE : pkg.value.trim() || 'com.discord.phoenix';

   summary.replaceChildren(
      part(`Build ${version.value}`, true),
      sep(),
      part(extras, true),
      sep(),
      part(target),
   );

   const pickedIpa = ipaFile.files?.[0]?.name ?? `Discord ${IOS_IPA.version}`;
   ipaSummary.replaceChildren(
      part(pickedIpa, true),
      sep(),
      part(runtime.checked ? pluginLabel : '0 plugins', true),
   );
};

document.addEventListener('change', update);
document.addEventListener('click', update);
document.addEventListener('input', update);
update();
</script>
